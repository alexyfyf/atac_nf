{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/alexyfyf/atac_nf/master/nextflow_schema.json",
    "title": "atac_nf pipeline parameters",
    "description": "ATAC-seq analysis Nextflow pipeline",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define where the pipeline should find input data and save output data.",
            "required": ["fasta"],
            "properties": {
                "input": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "schema": "assets/schema_input.json",
                    "description": "Path to a comma-separated file describing the samples.",
                    "help_text": "Requires the columns `sample` and `fastq_1`. `fastq_2` may be empty for single-end samples. Optional `replicate` and `condition` columns are carried through for downstream analysis.",
                    "fa_icon": "fas fa-file-csv"
                },
                "reads": {
                    "type": "string",
                    "description": "Legacy input: a quoted glob matching FASTQ file pairs, e.g. 'data/*_R{1,2}.fq.gz'.",
                    "help_text": "Retained for backwards compatibility with the DSL1 pipeline. Prefer --input, which also carries replicate and condition metadata.",
                    "fa_icon": "fas fa-asterisk"
                },
                "single_end": {
                    "type": "boolean",
                    "default": false,
                    "description": "Treat --reads input as single-end. Ignored when --input is used, where it is decided per sample.",
                    "fa_icon": "fas fa-align-left"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "default": "results",
                    "description": "Output directory for the results.",
                    "fa_icon": "fas fa-folder-open"
                },
                "publish_dir_mode": {
                    "type": "string",
                    "default": "copy",
                    "enum": ["symlink", "rellink", "link", "copy", "copyNoFollow", "move"],
                    "description": "Method used to save pipeline results to the output directory.",
                    "fa_icon": "fas fa-copy",
                    "hidden": true
                },
                "save_trimmed": {
                    "type": "boolean",
                    "default": false,
                    "description": "Publish the trimmed FASTQ files. They are large and rarely needed.",
                    "fa_icon": "fas fa-save"
                },
                "save_raw_bam": {
                    "type": "boolean",
                    "default": false,
                    "description": "Publish the pre-filtering BAM files.",
                    "fa_icon": "fas fa-save"
                }
            }
        },
        "reference_genome_options": {
            "title": "Reference genome options",
            "type": "object",
            "fa_icon": "fas fa-dna",
            "description": "Reference genome and derived annotation.",
            "properties": {
                "fasta": {
                    "type": "string",
                    "format": "file-path",
                    "mimetype": "text/plain",
                    "pattern": "^\\S+\\.(fa|fasta|fna)(\\.gz)?$",
                    "description": "Path to the reference genome FASTA.",
                    "fa_icon": "fas fa-file"
                },
                "genome": {
                    "type": "string",
                    "enum": ["mm10", "hg38"],
                    "description": "Genome preset, supplying the blacklist, MACS genome size and effective genome size.",
                    "help_text": "Presets live in conf/genomes.config. Any of the derived values can be overridden individually.",
                    "fa_icon": "fas fa-book"
                },
                "species": {
                    "type": "string",
                    "default": "mm10",
                    "description": "Deprecated alias for --genome, kept for backwards compatibility.",
                    "fa_icon": "fas fa-history",
                    "hidden": true
                },
                "aligner": {
                    "type": "string",
                    "default": "bwa",
                    "enum": ["bwa", "bwa-mem2"],
                    "description": "Read aligner. bwa-mem2 is faster but needs substantially more RAM to build its index.",
                    "fa_icon": "fas fa-map-signs"
                },
                "aligner_index": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Directory containing a pre-built index for the selected aligner. Skips the indexing step.",
                    "fa_icon": "fas fa-bezier-curve"
                },
                "blacklist": {
                    "type": "string",
                    "format": "file-path",
                    "description": "BED file of blacklisted regions. Overrides the genome preset.",
                    "fa_icon": "fas fa-ban"
                },
                "macs_gsize": {
                    "type": "string",
                    "description": "MACS effective genome size ('mm', 'hs', or a number). Overrides the genome preset.",
                    "fa_icon": "fas fa-arrows-alt-h"
                },
                "effective_genome_size": {
                    "type": "string",
                    "description": "Effective genome size used for RPGC normalisation of bigwigs. Overrides the genome preset.",
                    "fa_icon": "fas fa-arrows-alt-h"
                }
            }
        },
        "trimming_options": {
            "title": "Trimming options",
            "type": "object",
            "fa_icon": "fas fa-cut",
            "properties": {
                "trim": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run trimmomatic. When false the reads go straight to alignment.",
                    "fa_icon": "fas fa-cut"
                },
                "adapter": {
                    "type": "string",
                    "default": "atac",
                    "description": "Adapter set: 'atac'/'nextera', 'truseq', or a path to an adapter FASTA.",
                    "fa_icon": "fas fa-file"
                }
            }
        },
        "peak_calling_options": {
            "title": "Peak calling options",
            "type": "object",
            "fa_icon": "fas fa-mountain",
            "properties": {
                "macs_qvalue": {
                    "type": "number",
                    "default": 0.01,
                    "description": "MACS q-value (FDR) cutoff for narrow and broad peak calling.",
                    "fa_icon": "fas fa-filter"
                },
                "macs2qval": {
                    "type": "number",
                    "description": "Deprecated alias for --macs_qvalue.",
                    "fa_icon": "fas fa-history",
                    "hidden": true
                },
                "macs_format": {
                    "type": "string",
                    "default": "BED",
                    "enum": ["BED", "BAMPE"],
                    "description": "BED treats each read end as an independent Tn5 insertion; BAMPE calls on whole fragments.",
                    "fa_icon": "fas fa-file-code"
                },
                "hmmratac": {
                    "type": "boolean",
                    "default": false,
                    "description": "Additionally call peaks with MACS3 hmmratac.",
                    "fa_icon": "fas fa-mountain"
                }
            }
        },
        "resource_options": {
            "title": "Resource options",
            "type": "object",
            "fa_icon": "fas fa-microchip",
            "description": "Ceilings applied to every process request.",
            "properties": {
                "max_cpus": {
                    "type": "integer",
                    "description": "Maximum CPUs any single task may request. Defaults to the detected core count.",
                    "fa_icon": "fas fa-microchip"
                },
                "max_memory": {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d+)?\\s*\\.?\\s*(K|M|G|T)?B$",
                    "description": "Maximum memory any single task may request. Defaults to 90% of detected RAM.",
                    "fa_icon": "fas fa-memory"
                },
                "max_time": {
                    "type": "string",
                    "pattern": "^(\\d+\\.?\\s*(s|m|h|d|day)\\s*)+$",
                    "default": "240.h",
                    "description": "Maximum time any single task may request.",
                    "fa_icon": "far fa-clock"
                },
                "slurm_account": {
                    "type": "string",
                    "description": "SLURM account, passed as --account (used by -profile slurm).",
                    "fa_icon": "fas fa-users"
                },
                "slurm_qos": {
                    "type": "string",
                    "description": "SLURM QOS, passed as --qos (used by -profile slurm).",
                    "fa_icon": "fas fa-users"
                },
                "slurm_queue": {
                    "type": "string",
                    "description": "SLURM partition (used by -profile slurm).",
                    "fa_icon": "fas fa-users"
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-import",
            "properties": {
                "shift": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Perl script used for Tn5 offset correction.",
                    "fa_icon": "fas fa-code",
                    "hidden": true
                }
            }
        }
    },
    "allOf": [
        { "$ref": "#/$defs/input_output_options" },
        { "$ref": "#/$defs/reference_genome_options" },
        { "$ref": "#/$defs/trimming_options" },
        { "$ref": "#/$defs/peak_calling_options" },
        { "$ref": "#/$defs/resource_options" },
        { "$ref": "#/$defs/generic_options" }
    ]
}
