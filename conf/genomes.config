/*
 * Genome presets. Add a genome here rather than editing the workflow code — the DSL1 version
 * kept three parallel Groovy maps inline and silently fell back to mm10 for anything unknown.
 *
 * Any of these can be overridden per run with --blacklist / --macs_gsize / --effective_genome_size.
 */

params {
    genomes {
        'mm10' {
            blacklist             = "${projectDir}/assets/blacklists/mm10-blacklist.v2.bed"
            macs_gsize            = 'mm'
            effective_genome_size = 2652783500
        }
        'hg38' {
            blacklist             = "${projectDir}/assets/blacklists/hg38-blacklist.v2.bed"
            macs_gsize            = 'hs'
            effective_genome_size = 2913022398
        }
    }
}
