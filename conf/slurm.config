/*
 * SLURM execution.
 *
 * The DSL1 config hardcoded `--account=ls25 --qos=genomics --queue genomics` (Monash M3) into
 * the resource labels, which made the pipeline unusable on any other cluster. Those are now
 * parameters: pass --slurm_account / --slurm_qos / --slurm_queue, or set them in a site config.
 */

executor {
    name         = 'slurm'
    queueSize    = 200
    pollInterval = '30 sec'
}

process {
    executor      = 'slurm'
    stageInMode   = 'symlink'
    cache         = 'lenient'

    queue          = { params.slurm_queue ?: null }
    clusterOptions = {
        [ params.slurm_account ? "--account=${params.slurm_account}" : null,
          params.slurm_qos     ? "--qos=${params.slurm_qos}"         : null,
        ].findAll { it }.join(' ') ?: null
    }

    // Clamp requests to what the partition can actually satisfy; without this a retry that
    // doubles memory can ask for more than any node has and sit in the queue forever.
    resourceLimits = [ cpus: 32, memory: 256.GB, time: 168.h ]
}
