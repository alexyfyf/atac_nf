/*
 * Default resource requests.
 *
 * Requests scale with `task.attempt`, which is what the old `time_mod(x, 1)` / `memory_mod(x, 1)`
 * helpers were meant to do — they were always called with a literal 1, so a retry asked for
 * exactly the same resources that had just failed.
 */

process {
    resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ]

    cpus   = { 1     * task.attempt }
    memory = { 6.GB  * task.attempt }
    time   = { 4.h   * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel: process_low {
        cpus   = { 2    * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 6    * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 12   * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel: process_high_memory {
        // bwa-mem2 index needs ~28x the genome size in RAM.
        memory = { 200.GB * task.attempt }
    }

    // Backwards-compatible aliases for the original label names, so existing site configs
    // that reference `large` / `big` keep working.
    withLabel: large {
        cpus   = { 12   * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel: big {
        cpus   = { 4    * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
}
