/*
 * Default resource requests.
 *
 * Requests scale with `task.attempt`, which is what the old `time_mod(x, 1)` / `memory_mod(x, 1)`
 * helpers were meant to do — they were always called with a literal 1, so a retry asked for
 * exactly the same resources that had just failed.
 */

process {
    resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ]

    cpus   = { 1     * task.attempt }
    memory = { 6.GB  * task.attempt }
    time   = { 4.h   * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel: process_low {
        cpus   = { 2    * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 6    * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    // 16, not 12, to match the DSL1 pipeline's `large` label. This is a correctness matter for
    // the aligner, not just a throughput choice: bwa mem is NOT invariant to thread count. It
    // reads in batches of chunk_size*threads and re-estimates the insert-size distribution per
    // batch, so changing -t shifts a small number of mate-rescue and pairing calls. Measured
    // against the DSL1 pipeline on mm10 ATAC data: at -t 12 roughly 0.005% of reads differ
    // (2,466 of 50.8M); at -t 16 the BAMs are identical record for record.
    withLabel: process_high {
        cpus   = { 16   * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel: process_high_memory {
        // bwa-mem2 index needs ~28x the genome size in RAM.
        memory = { 200.GB * task.attempt }
    }

    // Belt and braces: the aligners are the processes where thread count provably changes output,
    // so pin them explicitly rather than relying on the label above staying at 16.
    //
    // Caveat: resourceLimits above clamps this to params.max_cpus, so on a machine with fewer
    // than 16 cores the drift returns. Set --max_cpus >= 16 when bit-identical output matters.
    withName: 'BWA_MEM|BWAMEM2_MEM' {
        cpus = 16
    }

    // Backwards-compatible aliases for the original label names, so existing site configs
    // that reference `large` / `big` keep working. `large` was 16 cpus in DSL1, so it is 16
    // here too -- at 12 the alias silently changed alignment output, which is the opposite of
    // backwards compatible.
    withLabel: large {
        cpus   = { 16   * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel: big {
        cpus   = { 4    * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
}
