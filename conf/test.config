/*
 * Minimal test profile.
 *
 *   nextflow run . -profile test,docker --outdir results
 *
 * Designed for `-stub-run` out of the box; a real run additionally needs the test FASTQs and
 * reference referenced below (see docs/usage.md).
 */

params {
    input                 = "${projectDir}/assets/samplesheet_test.csv"
    fasta                 = "${projectDir}/tests/data/genome.fa"
    genome                = null
    blacklist             = "${projectDir}/tests/data/blacklist.bed"
    gtf                   = "${projectDir}/tests/data/genes.gtf"
    tss_window            = 500
    tss_bin_size          = 50
    macs_gsize            = 100000
    effective_genome_size = 100000
    trim                  = true
    hmmratac              = false
}

process {
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 1.h ]
}
