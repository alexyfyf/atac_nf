/*
 * Per-process tool arguments and publishing.
 *
 * Keeping publishDir here (rather than inside each module) means the output layout can be
 * changed without touching pipeline code. The directory names match the DSL1 pipeline so
 * existing downstream scripts keep working.
 */

process {

    publishDir = [
        path   : { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode   : params.publish_dir_mode,
        saveAs : { filename -> filename.equals('versions.yml') ? null : filename },
    ]

    // --- Preprocessing -----------------------------------------------------

    withName: 'FASTQC_RAW' {
        ext.prefix = { "${meta.id}_raw" }
        publishDir = [
            path  : { "${params.outdir}/pre_fastqc" },
            mode  : params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                return filename.endsWith('.zip') ? "zips/${filename}" : filename
            },
        ]
    }

    withName: 'FASTQC_TRIM' {
        ext.prefix = { "${meta.id}_trimmed" }
        publishDir = [
            path  : { "${params.outdir}/post_fastqc" },
            mode  : params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                return filename.endsWith('.zip') ? "zips/${filename}" : filename
            },
        ]
    }

    withName: 'TRIMMOMATIC' {
        ext.args   = 'SLIDINGWINDOW:4:15 MINLEN:36'
        publishDir = [
            [
                path   : { "${params.outdir}/trim" },
                mode   : params.publish_dir_mode,
                pattern: '*_trim.log',
            ],
            [
                path   : { "${params.outdir}/trim" },
                mode   : params.publish_dir_mode,
                pattern: '*.fastq.gz',
                enabled: params.save_trimmed,
            ],
        ]
    }

    // --- Reference ---------------------------------------------------------

    withName: 'BWA_INDEX|BWAMEM2_INDEX' {
        publishDir = [ enabled: false ]
    }

    // --- Alignment ---------------------------------------------------------

    withName: 'BWA_MEM|BWAMEM2_MEM' {
        ext.prefix = { "${meta.id}_sorted" }
        publishDir = [
            path   : { "${params.outdir}/RawBamFiles" },
            mode   : params.publish_dir_mode,
            pattern: '*.{bam,bai}',
            enabled: params.save_raw_bam,
        ]
    }

    withName: 'SAMTOOLS_FILTER' {
        ext.prefix = { "${meta.id}.filtered" }
        publishDir = [ enabled: false ]
    }

    withName: 'PICARD_MARKDUPLICATES' {
        ext.args   = '--VALIDATION_STRINGENCY LENIENT'
        ext.prefix = { "${meta.id}_sorted_mdups" }
        publishDir = [
            path   : { "${params.outdir}/FilteredBamFiles" },
            mode   : params.publish_dir_mode,
            pattern: '*_dups.txt',
        ]
    }

    withName: 'PICARD_COLLECTMULTIPLEMETRICS' {
        publishDir = [
            path   : { "${params.outdir}/FilteredBamFiles" },
            mode   : params.publish_dir_mode,
            pattern: '*{_metrics,.pdf}',
        ]
    }

    withName: 'SAMTOOLS_STATS' {
        publishDir = [
            path   : { "${params.outdir}/FilteredBamFiles" },
            mode   : params.publish_dir_mode,
            pattern: '*.{flagstat,idxstats}',
        ]
    }

    withName: 'SAMTOOLS_STATS_FINAL' {
        ext.prefix = { "${meta.id}.final" }
        publishDir = [
            path   : { "${params.outdir}/FilteredBamFiles" },
            mode   : params.publish_dir_mode,
            pattern: '*.flagstat',
        ]
    }

    withName: 'SAMTOOLS_FINAL' {
        ext.prefix = { "${meta.id}.final" }
        publishDir = [
            path   : { "${params.outdir}/FilteredBamFiles" },
            mode   : params.publish_dir_mode,
            pattern: '*.{bam,bai}',
        ]
    }

    withName: 'PICARD_INSERTSIZE_FINAL' {
        // Only the fragment-size distribution: the alignment metrics beside it are already
        // collected on the raw BAM, where they belong.
        ext.programs = '--PROGRAM CollectInsertSizeMetrics'
        ext.prefix   = { "${meta.id}.final" }
        // Nothing to collect for single-end libraries, where there is no fragment length.
        ext.when     = { !meta.single_end }
        publishDir = [
            path   : { "${params.outdir}/FilteredBamFiles" },
            mode   : params.publish_dir_mode,
            pattern: '*.{insert_size_metrics,pdf}',
        ]
    }

    withName: 'LIBRARY_COMPLEXITY' {
        publishDir = [
            path   : { "${params.outdir}/FilteredBamFiles" },
            mode   : params.publish_dir_mode,
            pattern: '*_pbc.txt',
        ]
    }

    withName: 'ATAC_SHIFT_BAM' {
        publishDir = [
            path   : { "${params.outdir}/ShiftedBamFiles" },
            mode   : params.publish_dir_mode,
            pattern: '*.{bam,bai,txt}',
        ]
    }

    // --- Peak calling ------------------------------------------------------

    withName: 'BEDTOOLS_BAMTOBED' {
        ext.prefix = { "${meta.id}_pe" }
        publishDir = [ enabled: false ]
    }

    withName: 'MACS3_CALLPEAK_NARROW' {
        ext.args   = { "--qvalue ${params.macs2qval ?: params.macs_qvalue} --nomodel --shift -75 --extsize 150 --call-summits --keep-dup all" }
        ext.prefix = { "${meta.id}_narrow" }
        ext.format = params.macs_format
        publishDir = [
            path  : { "${params.outdir}/macs2" },
            mode  : params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'MACS3_CALLPEAK_BROAD' {
        ext.args   = { "--qvalue ${params.macs2qval ?: params.macs_qvalue} --nomodel --shift -75 --extsize 150 --keep-dup all --broad" }
        ext.prefix = { "${meta.id}_broad" }
        ext.format = params.macs_format
        publishDir = [
            path  : { "${params.outdir}/macs2" },
            mode  : params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'MACS3_HMMRATAC' {
        publishDir = [
            path  : { "${params.outdir}/hmmratac" },
            mode  : params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // --- QC and visualisation ---------------------------------------------

    withName: 'FRIP_SCORE' {
        publishDir = [
            path   : { "${params.outdir}/FRiP" },
            mode   : params.publish_dir_mode,
            pattern: '*.{metric,tsv}',
        ]
    }

    withName: 'DEEPTOOLS_BAMCOVERAGE' {
        ext.args   = '--normalizeUsing RPGC --binSize 50'
        publishDir = [
            path   : { "${params.outdir}/bigwig" },
            mode   : params.publish_dir_mode,
            pattern: '*.bw',
        ]
    }

    // --- Cross-sample analysis --------------------------------------------

    withName: 'CONSENSUS_PEAKS|ANNOTATE_PEAKS' {
        publishDir = [
            path   : { "${params.outdir}/consensus_peaks" },
            mode   : params.publish_dir_mode,
            pattern: '*.{bed,saf,tsv}',
        ]
    }

    withName: 'SUBREAD_FEATURECOUNTS' {
        publishDir = [
            path   : { "${params.outdir}/consensus_peaks" },
            mode   : params.publish_dir_mode,
            pattern: '*.txt*',
        ]
    }

    withName: 'DESEQ2_ANALYSIS' {
        ext.args   = { "--fdr ${params.deseq2_fdr}" }
        publishDir = [
            path  : { "${params.outdir}/differential" },
            mode  : params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'GTF_TO_TSS_BED' {
        publishDir = [ enabled: false ]
    }

    withName: 'TSS_ENRICHMENT' {
        publishDir = [
            path   : { "${params.outdir}/tss_enrichment" },
            mode   : params.publish_dir_mode,
            pattern: '*.{pdf,tsv,gz,json}',
        ]
    }

    withName: 'CHIPSEEKER_ANNOTATE' {
        ext.args   = { "--tss-region ${params.annotation_tss_region}" }
        publishDir = [
            path   : { "${params.outdir}/peak_annotation" },
            mode   : params.publish_dir_mode,
            pattern: '*.{tsv,pdf,txt}',
        ]
    }

    withName: 'QC_SUMMARY' {
        publishDir = [
            path   : { "${params.outdir}/qc_summary" },
            mode   : params.publish_dir_mode,
            pattern: '*.{tsv,pdf,txt}',
        ]
    }

    // --- Track hub ----------------------------------------------------------

    withName: 'UCSC_BEDTOBIGBED' {
        // Not published on its own: the bigBeds are copied into the hub directory, and a second
        // copy of every peak file is not worth the disk.
        publishDir = [ enabled: false ]
    }

    withName: 'UCSC_TRACKHUB' {
        // The hub name is a process input, not an argument, because the stub needs it too.
        ext.args   = { params.trackhub_url ? "--url ${params.trackhub_url}" : '' }
        publishDir = [
            path   : { "${params.outdir}" },
            mode   : params.publish_dir_mode,
            pattern: 'trackhub',
        ]
    }

    withName: 'MULTIQC' {
        publishDir = [
            path  : { "${params.outdir}/MultiQC" },
            mode  : params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
}
