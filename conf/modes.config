/*
 * Assay mode presets.
 *
 * Each block below is one assay. Nothing here is pipeline code -- a mode is data, so adding
 * cut&run or cut&tag means adding a block and a matching entry in the `mode` enum of
 * nextflow_schema.json, and nothing else, provided the new assay needs no attribute that does
 * not already exist. tests/check_modes.py asserts that every mode declares the full contract
 * and that the schema enum matches, so a half-written preset fails in CI rather than resolving
 * to null somewhere deep inside a script block.
 *
 * Every attribute is a *default*: an explicit --shift / --adapter / --macs_format on the command
 * line always wins, exactly as --blacklist wins over a genome preset's blacklist.
 *
 * Attribute contract (see tests/check_modes.py, which enforces it):
 *
 *   description      string        shown in the run banner
 *   single_end       bool          default read layout. Only consulted for the legacy --reads
 *                                  glob and for a mismatch warning; a samplesheet always decides
 *                                  per sample, so paired-end ChIP and single-end ATAC both work.
 *   shift            bool          run Tn5 offset correction (+4/-5). Paired-end only: the
 *                                  bundled perl script filters on proper-pair SAM flags.
 *   adapter          string        default --adapter preset ('nextera', 'truseq', or a path)
 *   macs_input       'bed'|'bam'   what MACS3 is called on. 'bed' converts the BAM first so each
 *                                  read end is an independent Tn5 insertion; 'bam' hands MACS
 *                                  the alignments and lets it model fragments itself.
 *   macs_extra_args  string        mode-specific MACS3 flags, appended to the shared ones in
 *                                  conf/modules.config
 *   hmmratac         bool          whether --hmmratac is permitted at all
 */

params {
    modes {
        atac {
            description     = 'ATAC-seq (Tn5 transposition)'
            single_end      = false
            shift           = true
            adapter         = 'nextera'
            macs_input      = 'bed'
            macs_extra_args = '--nomodel --shift -75 --extsize 150'
            hmmratac        = true
        }
        chip {
            description     = 'ChIP-seq'
            single_end      = true
            shift           = false
            adapter         = 'truseq'
            macs_input      = 'bam'
            // No --nomodel: ChIP-seq wants MACS3's own shifting model, built from the tag
            // pileup for single-end data and from real fragments for paired-end.
            macs_extra_args = ''
            hmmratac        = false
        }
    }
}
