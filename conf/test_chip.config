/*
 * Minimal ChIP-seq test profile.
 *
 *   nextflow run . -profile test_chip,docker --outdir results
 *
 * Deliberately mixes one paired-end and one single-end sample: that covers MACS3's --format
 * BAMPE and --format BAM derivations, the all-libraries-paired check in DOWNSTREAM_ANALYSIS
 * that decides whether featureCounts counts pairs or reads, and the warning that fires when a
 * samplesheet disagrees with the mode's expected layout.
 *
 * Like -profile test, this is designed for `-stub-run` out of the box; a real run additionally
 * needs the test FASTQs and reference referenced below (see docs/usage.md).
 */

params {
    // Never reach for S3 in tests or CI.
    igenomes_ignore       = true

    mode                  = 'chip'
    input                 = "${projectDir}/assets/samplesheet_test_chip.csv"
    fasta                 = "${projectDir}/tests/data/genome.fa"
    genome                = null
    blacklist             = "${projectDir}/tests/data/blacklist.bed"
    gtf                   = "${projectDir}/tests/data/genes.gtf"
    tss_window            = 500
    tss_bin_size          = 50
    macs_gsize            = 100000
    effective_genome_size = 100000

    // Explicitly null rather than simply absent. nf-test.config pins `profile "test"` for the
    // whole suite and layers this file on top with -c, so conf/test.config's `trim = true`
    // would otherwise survive and the chip preset's own no-trim default would never be
    // exercised by any test. Null hands the decision back to the mode in both paths:
    // `-profile test_chip` from the command line, and the nf-test overlay.
    trim                  = null
}

process {
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 1.h ]
}
