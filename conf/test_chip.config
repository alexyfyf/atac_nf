/*
 * Minimal ChIP-seq test profile.
 *
 *   nextflow run . -profile test_chip,docker --outdir results
 *
 * Deliberately mixes one paired-end and one single-end sample: that covers MACS3's --format
 * BAMPE and --format BAM derivations, and the all-libraries-paired check in
 * DOWNSTREAM_ANALYSIS that decides whether featureCounts counts pairs or reads.
 *
 * Like -profile test, this is designed for `-stub-run` out of the box; a real run additionally
 * needs the test FASTQs and reference referenced below (see docs/usage.md).
 */

params {
    // Never reach for S3 in tests or CI.
    igenomes_ignore       = true

    mode                  = 'chip'
    input                 = "${projectDir}/assets/samplesheet_test_chip.csv"
    fasta                 = "${projectDir}/tests/data/genome.fa"
    genome                = null
    blacklist             = "${projectDir}/tests/data/blacklist.bed"
    gtf                   = "${projectDir}/tests/data/genes.gtf"
    tss_window            = 500
    tss_bin_size          = 50
    macs_gsize            = 100000
    effective_genome_size = 100000
    trim                  = true
}

process {
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 1.h ]
}
