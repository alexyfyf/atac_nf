/*
 * ATAC_nf - pipeline configuration
 */

params {
    // --- Input -------------------------------------------------------------
    input                 = null    // samplesheet CSV (preferred)
    reads                 = null    // legacy glob, e.g. 'data/*_R{1,2}.fq.gz'
    single_end            = false   // only used with --reads; the samplesheet decides per sample

    // --- Reference ---------------------------------------------------------
    fasta                 = null
    genome                = null    // key into params.genomes (see conf/genomes.config)
    species               = 'mm10'  // deprecated alias for --genome
    aligner               = 'bwa'   // 'bwa' | 'bwa-mem2'
    aligner_index         = null    // pre-built index directory; skips the index step
    blacklist             = null    // overrides the genome default
    macs_gsize            = null    // overrides the genome default
    effective_genome_size = null    // overrides the genome default

    // --- Trimming ----------------------------------------------------------
    trim                  = true
    adapter               = 'atac'  // 'atac'/'nextera', 'truseq', or a path to a FASTA

    // --- Peak calling ------------------------------------------------------
    macs_qvalue           = 0.01
    macs2qval             = null    // deprecated alias for --macs_qvalue
    macs_format           = 'BED'   // 'BED' treats each read end as a Tn5 insertion; 'BAMPE' uses fragments
    hmmratac              = false

    // --- Misc --------------------------------------------------------------
    shift                 = "${projectDir}/bin/ATAC_BAM_shifter_gappedAlign.pl"
    outdir                = 'results'
    publish_dir_mode      = 'copy'
    save_trimmed          = false   // intermediate FASTQs are large; opt in
    save_raw_bam          = false   // pre-filtering BAMs; opt in

    // --- Cluster (used by -profile slurm) ----------------------------------
    slurm_account         = null
    slurm_qos             = null
    slurm_queue           = null

    // --- Resource ceilings -------------------------------------------------
    // Requests are clamped to these, so a laptop run does not fail at submit time with
    // "process requirement exceeds available CPUs". -profile slurm raises them.
    max_cpus              = detectCpus()
    max_memory            = detectMemory()
    max_time              = 240.h
}

def detectCpus() {
    return Runtime.runtime.availableProcessors()
}

def detectMemory() {
    try {
        def meminfo = new File('/proc/meminfo')
        if (meminfo.exists()) {
            def line = meminfo.readLines().find { it.startsWith('MemTotal:') }
            if (line) {
                // MemTotal is in kB; leave a little headroom for the JVM and the OS.
                return nextflow.util.MemoryUnit.of((long) ((line.split()[1] as long) * 1024 * 0.9))
            }
        }
    }
    catch (Exception e) {
        // Fall through to the default below.
    }
    return 128.GB
}

// Genome presets (blacklist / macs_gsize / effective_genome_size)
includeConfig 'conf/genomes.config'

// Per-process resources
includeConfig 'conf/base.config'

// Per-process publishDir and tool arguments
includeConfig 'conf/modules.config'

profiles {
    debug {
        cleanup                 = false
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        apptainer.enabled       = false
        conda.channels          = ['conda-forge', 'bioconda']
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        apptainer.enabled       = false
        conda.channels          = ['conda-forge', 'bioconda']
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
    }
    wave {
        // Builds images on the fly from each process's `conda` directive.
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

// Execution reports
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}

manifest {
    name            = 'atac_nf'
    homePage        = 'https://github.com/alexyfyf/atac_nf'
    description     = 'ATAC-seq analysis Nextflow pipeline'
    author          = 'Feng Yan'
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    version         = '2.0.0dev'
    nextflowVersion = '!>=24.04.0'
}
