/*
 * ATAC_nf - pipeline configuration
 */

params {
    // --- Assay mode --------------------------------------------------------
    mode                  = 'atac'  // key into params.modes (see conf/modes.config)

    // --- Input -------------------------------------------------------------
    input                 = null    // samplesheet CSV (preferred)
    reads                 = null    // legacy glob, e.g. 'data/*_R{1,2}.fq.gz'
    single_end            = null    // only used with --reads; null takes the mode's default,
                                    // and the samplesheet always decides per sample

    // --- Reference ---------------------------------------------------------
    fasta                 = null
    genome                = null    // key into params.genomes (see conf/igenomes.config)
    species               = 'mm10'  // deprecated alias for --genome
    aligner               = 'bwa'   // 'bwa' | 'bwa-mem2'
    aligner_index         = null    // pre-built index directory; skips the index step
    blacklist             = null    // overrides the genome default
    macs_gsize            = null    // overrides the genome default
    effective_genome_size = null    // overrides the genome default
    mito_name             = null    // mitochondrial contig name; overrides the genome default
    read_length           = null    // selects the macs_gsize entry for the genome

    // --- AWS iGenomes -------------------------------------------------------
    igenomes_base         = 's3://ngi-igenomes/igenomes'
    igenomes_ignore       = false   // true skips conf/igenomes.config entirely (offline use)

    // --- Trimming ----------------------------------------------------------
    trim                  = true
    adapter               = null    // null takes the mode's default;
                                    // 'atac'/'nextera', 'truseq', or a path to a FASTA

    // --- Peak calling ------------------------------------------------------
    macs_qvalue           = 0.01
    macs2qval             = null    // deprecated alias for --macs_qvalue
    macs_format           = null    // null derives from the mode and the read layout; set
                                    // 'BED', 'BAM' or 'BAMPE' to pin it
    hmmratac              = false

    // --- Downstream analysis -----------------------------------------------
    gtf                   = null    // enables TSS enrichment and peak annotation
    tss_window            = 2000    // bp either side of the TSS for the enrichment profile
    tss_bin_size          = 10
    skip_consensus        = false   // consensus peaks, counts matrix, DESeq2
    skip_deseq2           = false
    skip_tss_enrichment   = false
    deseq2_fdr            = 0.05

    // --- Misc --------------------------------------------------------------
    shift                 = null    // Tn5 offset correction; null takes the mode's default
    shift_script          = "${projectDir}/bin/ATAC_BAM_shifter_gappedAlign.pl"
    outdir                = 'results'
    publish_dir_mode      = 'copy'
    save_trimmed          = false   // intermediate FASTQs are large; opt in
    save_raw_bam          = false   // pre-filtering BAMs; opt in

    // --- Cluster (used by -profile slurm) ----------------------------------
    slurm_account         = null
    slurm_qos             = null
    slurm_queue           = null

    // --- Resource ceilings -------------------------------------------------
    // Every process request is clamped to these (see conf/base.config). CPUs default to what
    // the machine actually has, so a local run does not fail at submit time with "process
    // requirement exceeds available CPUs"; memory and time are conservative ceilings you are
    // expected to raise or lower for your machine, e.g. --max_memory 16.GB.
    // -profile slurm and -profile test set their own limits.
    max_cpus              = Runtime.runtime.availableProcessors()
    max_memory            = 128.GB
    max_time              = 240.h
}

// Per-process resources
includeConfig 'conf/base.config'

// Per-process publishDir and tool arguments
includeConfig 'conf/modules.config'

profiles {
    debug {
        cleanup                 = false
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        apptainer.enabled       = false
        conda.channels          = ['conda-forge', 'bioconda']
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        apptainer.enabled       = false
        conda.channels          = ['conda-forge', 'bioconda']
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
    }
    wave {
        // Builds images on the fly from each process's `conda` directive.
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
    test_chip {
        includeConfig 'conf/test_chip.config'
    }
}

// Assay mode presets: what each assay changes about trimming, the Tn5 shift and peak calling.
//
// Included unconditionally for the same reason as conf/igenomes.config below: the strict config
// parser in Nextflow 25+ rejects if statements in a config file, and the entries are inert until
// something consumes them.
includeConfig 'conf/modes.config'

// Genome presets: FASTA/bwa index/GTF paths on S3, plus blacklist, mito_name and macs_gsize.
//
// Always included, and honoured or ignored at runtime by --igenomes_ignore (see main.nf).
// nf-core wraps this in `if (!params.igenomes_ignore) { includeConfig ... }`, but the strict
// config parser in Nextflow 25+ rejects if statements in a config file. Including it
// unconditionally costs nothing — the entries are just strings, and no path is fetched until
// something consumes it — and it has the side benefit that --igenomes_ignore now works from the
// command line, which the config-level conditional never could.
includeConfig 'conf/igenomes.config'

// Execution reports.
// Fixed filenames with overwrite rather than a timestamp: the strict config parser in
// Nextflow 25+ rejects variable declarations in a config file, and a stable name is easier
// to reference from CI anyway.
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
}

manifest {
    name            = 'atac_nf'
    homePage        = 'https://github.com/alexyfyf/atac_nf'
    description     = 'ATAC-seq analysis Nextflow pipeline'
    author          = 'Feng Yan'
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    version         = '2.0.0dev'
    nextflowVersion = '!>=24.04.0'
}
